{
    "compilerOptions": {
      "rootDir": "./src",
      "outDir": "./dist",
      "module": "CommonJS",
      "ignoreDeprecations": "5.0",
      "moduleResolution": "node", 
      "target": "ES2020",
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "strict": true,
      "skipLibCheck": true,
      "declaration": true,
      "sourceMap": true
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
  }