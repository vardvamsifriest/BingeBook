{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "backend": {
        "root": "apps/backend",
        "framework": "express"
      },
      "web": {
        "root": "apps/web",
        "framework": "nextjs",
        "bindings": [
          {
            "type": "service",
            "service": "backend",
            "format": "url",
            "env": "BACKEND_URL"
          }
        ]
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "web"
        }
      }
    ]
  }