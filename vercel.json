{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "backend": {
        "root": "apps/backend",
        "framework": "express"
      },
      "web": {
        "root": "apps/web",
        "framework": "nextjs"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "web"
        }
      }
    ]
  }